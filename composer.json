{
    "name": "egrajp/development-corelibs-dev",
    "version": "dev-master",
    "description": "CoreLibs: Development package",
    "keywords": ["corelib", "logging", "database", "templating", "tools"],
    "type": "library",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "phan/phan": "^6.0",
        "phpunit/phpunit": "^9",
        "yamadashy/phpstan-friendly-formatter": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "@php -d xdebug.mode=coverage vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyze",
        "phan": [
            "@putenv PHAN_DISABLE_XDEBUG_WARN=1",
            "vendor/bin/phan --progress-bar -C --analyze-twice"
        ]
    }
}
